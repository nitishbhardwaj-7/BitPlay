    "preinstall": "node -e \"if(process.env.CI||process.env.BUN||!require('fs').existsSync('package-lock.json'))process.exit(0); try{require('child_process').execSync('npx npm-force-resolutions',{stdio:'inherit'})}catch(e){console.warn('npm-force-resolutions skipped:',e.message)}\"",
