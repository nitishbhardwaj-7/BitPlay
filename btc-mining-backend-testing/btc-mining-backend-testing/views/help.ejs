<%- include('partials/header', { title: 'Support Tickets' }) %>
<%- include('partials/sidebar', { title: 'Support Tickets', user }) %>

<!-- Reply Modal -->
<div class="modal fade" id="emailModal" tabindex="-1" aria-labelledby="emailModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <form id="emailForm" method="POST">
        <div class="modal-content">
            <div class="modal-header">
              <h5 class="modal-title">Reply to Ticket</h5>
              <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                  <div style="font-size:12px;color:var(--text-faint);margin-bottom:2px">Name</div>
                  <div style="font-weight:600" id="modalName"></div>
                </div>
                <div class="mb-3">
                  <div style="font-size:12px;color:var(--text-faint);margin-bottom:2px">Email</div>
                  <div style="font-weight:600" id="modalEmail"></div>
                </div>
                <div>
                  <label class="form-label">Your Reply</label>
                  <textarea class="form-control" name="replyMessage" id="replyMessage" placeholder="Type your reply..." rows="5" required></textarea>
                  <input type="hidden" id="ticketEmail" name="email">
                </div>
            </div>
            <div class="modal-footer">
              <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
              <button type="submit" class="btn btn-primary">Send Reply</button>
            </div>
        </div>
        </form>
    </div>
</div>

<div class="page-inner">

  <div id="loading" style="display:none;color:var(--text-faint);font-size:13px;margin-bottom:12px">Searching…</div>

  <!-- Page Hero -->
  <div class="page-hero">
    <div class="page-hero-text">
      <h1>Support Tickets</h1>
      <p>Manage and respond to user support requests</p>
    </div>
    <div class="page-hero-actions">
      <div class="search-bar">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
        <input type="text" id="ticketSearch" placeholder="Search tickets…" value="<%= searchQuery || '' %>" />
      </div>
    </div>
  </div>

  <div class="data-card">
    <div class="table-wrapper" id="ticketsTableContainer">
      <table class="table table-hover align-middle" id="ticketsTable">
        <thead>
          <tr>
            <th style="width:48px">#</th>
            <th>User</th>
            <th>Email</th>
            <th>Message</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody id="ticketsTbody">
          <% tickets.forEach((ticket, index) => { %>
            <tr data-id="<%= ticket._id %>" data-name="<%= ticket.name %>" data-email="<%= ticket.email %>">
              <td style="color:var(--text-faint);font-size:12px"><%= (page - 1) * limit + index + 1 %></td>
              <td style="font-weight:600;color:var(--text)"><%= ticket.name %></td>
              <td style="color:var(--text-faint)"><%= ticket.email %></td>
              <td style="color:var(--text-muted);max-width:300px"><%= ticket.message %></td>
              <td class="text-center">
                <span class="icon-box text-primary me-1 email-btn" role="button" title="Email">
                  <i class="fas fa-envelope"></i>
                </span>
                <span class="icon-box text-danger delete-btn" role="button" title="Delete">
                  <i class="fas fa-trash-alt"></i>
                </span>
              </td>
            </tr>
          <% }) %>
          <% if (tickets.length === 0) { %>
            <tr><td colspan="5">
              <div class="empty-state">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
                <h4>No support tickets</h4>
                <p>All caught up! No open tickets at the moment</p>
              </div>
            </td></tr>
          <% } %>
        </tbody>
      </table>
    </div>

    <div class="pag-bar">
      <% if (page > 1) { %>
        <a href="?page=<%= page - 1 %><%= searchQuery ? '&q=' + encodeURIComponent(searchQuery) : '' %>" class="btn btn-secondary btn-sm">&larr; Prev</a>
      <% } %>
      <span class="pag-info">Page <%= page %></span>
      <% if (tickets.length === limit) { %>
        <a href="?page=<%= page + 1 %><%= searchQuery ? '&q=' + encodeURIComponent(searchQuery) : '' %>" class="btn btn-secondary btn-sm">Next &rarr;</a>
      <% } %>
    </div>
  </div>

</div>

    <!-- Live Search Script -->
    <script>
        const searchInput = document.getElementById('ticketSearch');
        const ticketsTbody = document.getElementById('ticketsTbody');

        let searchTimeout;
        searchInput.addEventListener('input', () => {
            clearTimeout(searchTimeout);

            searchTimeout = setTimeout(async () => {
                const query = searchInput.value.trim();

                try {
                    const response = await fetch(`/admin/help?q=${encodeURIComponent(query)}&page=1`, {
                        headers: { 'X-Requested-With': 'XMLHttpRequest' }
                    });

                    const data = await response.json();
                    ticketsTbody.innerHTML = '';

                    if (data.tickets.length === 0) {
                        ticketsTbody.innerHTML = '<tr><td colspan="5">No tickets found</td></tr>';
                        return;
                    }

                    data.tickets.forEach((ticket, index) => {
                        const row = document.createElement('tr');
                        row.setAttribute('data-id', ticket._id);

                        row.innerHTML = `
                            <td>${index + 1}</td>
                            <td>${ticket.name}</td>
                            <td>${ticket.email}</td>
                            <td>${ticket.message}</td>
                            <td class="text-center">
                                <span class="icon-box text-primary me-1 email-btn" role="button" title="Email">
                                    <i class="fas fa-envelope"></i>
                                </span>
                                <span class="icon-box text-danger delete-btn" role="button" title="Delete">
                                    <i class="fas fa-trash-alt"></i>
                                </span>
                            </td>
                        `;

                        ticketsTbody.appendChild(row);
                    });

                } catch (err) {
                    console.error('Search failed:', err);
                }
            }, 300);
        });

        document.querySelectorAll('.delete-btn').forEach(btn => {
            btn.addEventListener('click', async (e) => {
                const row = e.target.closest('tr');
                const id = row.dataset.id;

                if (confirm('Are you sure you want to delete this ticket?')) {
                try {
                    const res = await fetch(`/api/help/${id}/delete`, { method: 'DELETE' });
                    if (res.ok) {
                    row.remove();
                    } else {
                    alert('Failed to delete ticket.');
                    }
                } catch (err) {
                    console.error('Delete failed:', err);
                }
                }
            });
        });

        document.querySelectorAll('.email-btn').forEach(btn => {
            btn.addEventListener('click', e => {
                const row = e.target.closest('tr');
                const name = row.dataset.name;
                const email = row.dataset.email;

                document.getElementById('modalName').textContent = name;
                document.getElementById('modalEmail').textContent = email;
                document.getElementById('ticketEmail').value = email;
                document.getElementById('replyMessage').value = '';

                const modal = new bootstrap.Modal(document.getElementById('emailModal'));
                modal.show();
            });
        });

        document.getElementById('emailForm').addEventListener('submit', async e => {
            e.preventDefault();
            const form = e.target;
            const email = form.email.value;
            const message = form.replyMessage.value;

            try {
                const res = await fetch('/api/help/reply', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ email, message })
                });

                if (res.ok) {
                alert('Reply sent!');
                bootstrap.Modal.getInstance(document.getElementById('emailModal')).hide();
                } else {
                alert('Failed to send email.');
                }
            } catch (err) {
                console.error('Email send failed:', err);
            }
        });

    </script>

    <script>
        const loading = document.getElementById('loading');
        loading.style.display = 'block';
        loading.style.display = 'none';
    </script>

<%- include('partials/footer') %>
