<%- include('partials/header', { title: 'Profile' }) %>
<%- include('partials/sidebar', { title: 'Profile', user }) %>

<div class="page-inner">

  <div class="page-hero">
    <div class="page-hero-text">
      <h1>Your Profile</h1>
      <p>Manage your admin account details</p>
    </div>
  </div>

  <% if (successMessage) { %>
    <div class="alert alert-success alert-dismissible fade show mb-4" role="alert">
      <%= successMessage %>
      <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
  <% } %>
  <% if (errorMessage) { %>
    <div class="alert alert-danger alert-dismissible fade show mb-4" role="alert">
      <%= errorMessage %>
      <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
  <% } %>

  <div class="profile-hero">
    <div class="profile-avatar-lg">
      <%= user.name ? user.name.charAt(0).toUpperCase() : 'A' %>
    </div>
    <div class="profile-hero-text">
      <h2><%= user.name ? user.name.toUpperCase() : 'ADMIN' %></h2>
      <p>Administrator &mdash; BitPlayPro</p>
    </div>
  </div>

  <div class="form-section">
    <h3>Account Details</h3>
    <form action="/api/profile/save" method="POST">
      <div class="row g-3">
        <div class="col-md-6">
          <label class="form-label">First Name</label>
          <input type="text" name="firstname" class="form-control" placeholder="First Name" value="<%= webUser.firstname || '' %>">
        </div>
        <div class="col-md-6">
          <label class="form-label">Last Name</label>
          <input type="text" name="lastname" class="form-control" placeholder="Last Name" value="<%= webUser.lastname || '' %>">
        </div>
        <div class="col-md-6">
          <label class="form-label">Organization</label>
          <input type="text" name="orgname" class="form-control" placeholder="Organization Name" value="<%= webUser.orgname || '' %>">
        </div>
        <div class="col-md-6">
          <label class="form-label">Location</label>
          <input type="text" name="location" class="form-control" placeholder="Location" value="<%= webUser.location || '' %>">
        </div>
        <div class="col-md-6">
          <label class="form-label">Email Address</label>
          <input type="email" name="email" class="form-control" placeholder="Email" value="<%= webUser.email || '' %>">
        </div>
        <div class="col-md-6">
          <label class="form-label">Phone Number</label>
          <input type="tel" name="phone" class="form-control" placeholder="Phone" value="<%= webUser.phone || '' %>">
        </div>
        <div class="col-12 mt-4">
          <button type="submit" class="btn btn-primary">Save Changes</button>
        </div>
      </div>
    </form>
  </div>

</div>

<script>
setTimeout(function() {
  document.querySelectorAll('.alert').forEach(function(alert) {
    try { new bootstrap.Alert(alert).close(); } catch(e){}
  });
}, 5000);
</script>

<%- include('partials/footer') %>
