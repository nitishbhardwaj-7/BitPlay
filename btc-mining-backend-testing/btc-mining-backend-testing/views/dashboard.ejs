<%- include('partials/header', { title }) %>

  <%- include('partials/sidebar', { title }) %>

  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

  <div class="main-content">

    <main class="page-content">
      <!-- Stats Cards -->
      <div class="stats-grid">
        <div class="stat-card revenue">
          <div class="stat-info">
            <h3>Total Revenue <i class="fas fa-dollar-sign cards-icon"></i></h3>
            <p class="stat-value">$<%= data.totalRevenue.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %></p>
            <% if (data.revenueChange !== null) { %>
              <span class="stat-change <%= parseFloat(data.revenueChange) >= 0 ? 'positive' : 'negative' %>">
                <%= parseFloat(data.revenueChange) >= 0 ? '+' : '' %><%= data.revenueChange %>% vs last month
              </span>
            <% } else { %>
              <span class="stat-change">No prior month data</span>
            <% } %>
          </div>
        </div>

        <div class="stat-card users">
          <div class="stat-info">
            <h3>Total Users <i class="fas fa-users cards-icon"></i></h3>
            <p class="stat-value"><%= usersCount.toLocaleString() %></p>
            <span class="stat-change positive"><%= users_diff %> since last week</span>
          </div>
        </div>

        <div class="stat-card transactions">
          <div class="stat-info">
            <h3>Transactions <i class="fas fa-credit-card cards-icon"></i></h3>
            <p class="stat-value"><%= TransactionsCount.toLocaleString() %></p>
            <span class="stat-change positive"><%= transactions_diff %> since last week</span>
          </div>
        </div>

        <div class="stat-card support">
          <div class="stat-info">
            <h3>Support Tickets <i class="fas fa-headset cards-icon"></i></h3>
            <p class="stat-value"><%= supportTicketsCount.toLocaleString() %></p>
            <span class="stat-change positive"><%= supportTicketsDiff %> since last week</span>
          </div>
        </div>
      </div>

      <!-- Performance Chart -->
      <div class="chart-container">
        <div class="chart-header">
          <h3>Revenue (Last 12 Months)</h3>
        </div>
        <canvas id="performanceChart"></canvas>
      </div>

      <!-- Recent Transactions -->
      <div class="transactions-container">
        <div class="transactions-header">
          <h3>Recent Activity</h3>
        </div>
        <div class="transactions-list">
          <% if (recentTransactions.length === 0) { %>
            <div class="transaction-item">
              <div class="transaction-info">
                <h4 class="rec-t-main">No recent transactions</h4>
                <p class="rec-t-sub">Activity will appear here once purchases or deposits are made</p>
              </div>
            </div>
          <% } else { %>
            <% recentTransactions.forEach(tx => { %>
              <div class="transaction-item">
                <div class="transaction-info">
                  <h4 class="rec-t-main"><%= tx.label %></h4>
                  <p class="rec-t-sub"><%= tx.sub %></p>
                </div>
                <div class="transaction-amount <%= tx.type %>"><%= tx.amount %></div>
              </div>
            <% }) %>
          <% } %>
        </div>
      </div>
    </main>
  </div>

  <script>
    const ctx = document.getElementById('performanceChart').getContext('2d');
    const chart = new Chart(ctx, {
      type: 'line',
      data: {
        labels: <%- chartLabels %>,
        datasets: [{
          label: 'Revenue ($)',
          data: <%- chartData %>,
          borderColor: '#8B5CF6',
          backgroundColor: 'rgba(139, 92, 246, 0.1)',
          fill: true,
          tension: 0.4
        }]
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        plugins: { legend: { display: false } },
        layout: { padding: { bottom: 30 } },
        scales: {
          y: {
            beginAtZero: true,
            grid: { color: 'rgba(255, 255, 255, 0.1)' },
            ticks: {
              color: '#9CA3AF',
              callback: (v) => '$' + v.toLocaleString()
            }
          },
          x: {
            grid: { color: 'rgba(255, 255, 255, 0.1)' },
            ticks: { color: '#9CA3AF' }
          }
        }
      }
    });
  </script>

<%- include('partials/footer') %>
