<%- include('partials/header', { title: 'Games History' }) %>
<%- include('partials/sidebar', { title: 'Games History', user }) %>

<div class="page-inner">

  <!-- Page Hero -->
  <div class="page-hero">
    <div class="page-hero-text">
      <h1>Games History</h1>
      <p>View all user game sessions and outcomes</p>
    </div>
    <div class="page-hero-actions">
      <a href="/admin/games-history/export" class="btn btn-secondary">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="width:15px;height:15px"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
        Export CSV
      </a>
    </div>
  </div>

  <!-- KPI Cards -->
  <div class="stats-grid" style="margin-bottom:24px">
    <div class="stat-card">
      <div class="stat-card-label" style="margin-bottom:12px">Total Sessions</div>
      <div class="stat-value" style="font-size:28px"><%= totalSessions %></div>
    </div>
    <div class="stat-card">
      <div class="stat-card-label" style="margin-bottom:12px">Unique Players</div>
      <div class="stat-value" style="font-size:28px"><%= uniquePlayers %></div>
    </div>
    <div class="stat-card">
      <div class="stat-card-label" style="margin-bottom:12px">Today</div>
      <div class="stat-value" style="font-size:28px"><%= todaySessions %></div>
    </div>
    <div class="stat-card">
      <div class="stat-card-label" style="margin-bottom:12px">Most Played</div>
      <div class="stat-value" style="font-size:18px;letter-spacing:-0.5px"><%= mostPlayedGame %></div>
    </div>
  </div>

  <!-- Filters -->
  <div class="data-card" style="margin-bottom:16px;padding:16px 20px">
    <form method="GET" action="/admin/games-history" style="display:flex;gap:10px;flex-wrap:wrap;align-items:center">
      <select name="gameName" class="form-select" style="max-width:200px" onchange="this.form.submit()">
        <option value="">All Games</option>
        <% games.forEach(function(g) { %>
          <option value="<%= g %>" <%= selectedGame === g ? 'selected' : '' %>><%= g %></option>
        <% }); %>
      </select>
      <select name="result" class="form-select" style="max-width:160px" onchange="this.form.submit()">
        <option value="">All Results</option>
        <option value="win"      <%= selectedResult === 'win'      ? 'selected' : '' %>>Win</option>
        <option value="lose"     <%= selectedResult === 'lose'     ? 'selected' : '' %>>Lose</option>
        <option value="complete" <%= selectedResult === 'complete' ? 'selected' : '' %>>Complete</option>
      </select>
      <input type="text" name="userId" class="form-control" style="max-width:200px" placeholder="Search User ID…" value="<%= selectedUser %>" />
      <button type="submit" class="btn btn-primary">Filter</button>
      <a href="/admin/games-history" class="btn btn-ghost">Reset</a>
    </form>
  </div>

  <!-- Table -->
  <div class="data-card">
    <div class="table-wrapper">
      <table class="table table-hover align-middle">
        <thead>
          <tr>
            <th>#</th>
            <th>User ID</th>
            <th>Game</th>
            <th>Score</th>
            <th>Result</th>
            <th>Duration</th>
            <th>Round</th>
            <th>Date</th>
          </tr>
        </thead>
        <tbody>
          <% if (sessions.length === 0) { %>
            <tr><td colspan="8">
              <div class="empty-state">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="3" width="20" height="14" rx="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/></svg>
                <h4>No sessions found</h4>
                <p>No game sessions match your current filters</p>
              </div>
            </td></tr>
          <% } %>
          <% sessions.forEach(function(s, i) { %>
            <tr>
              <td style="color:var(--text-faint);font-size:12px"><%= (page - 1) * limit + i + 1 %></td>
              <td style="font-family:monospace;font-size:12px;color:var(--text-faint)"><%= s.userId %></td>
              <td><span class="badge bg-primary"><%= s.gameName %></span></td>
              <td style="font-weight:600"><%= s.score.toLocaleString() %></td>
              <td>
                <% if (s.result === 'win') { %>
                  <span class="badge bg-success">Win</span>
                <% } else if (s.result === 'lose') { %>
                  <span class="badge bg-danger">Lose</span>
                <% } else { %>
                  <span class="badge bg-primary">Complete</span>
                <% } %>
              </td>
              <td style="color:var(--text-muted)"><%= s.durationSeconds %>s</td>
              <td style="color:var(--text-faint)">#<%= s.roundNumber %></td>
              <td style="white-space:nowrap;color:var(--text-faint);font-size:12px"><%= new Date(s.createdAt).toLocaleDateString('en-US',{month:'short',day:'numeric',year:'numeric'}) %></td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>

    <div class="pag-bar">
      <% if (page > 1) { %>
        <a href="?page=<%= page - 1 %>&gameName=<%= selectedGame %>&result=<%= selectedResult %>&userId=<%= selectedUser %>" class="btn btn-secondary btn-sm">&larr; Prev</a>
      <% } %>
      <span class="pag-info">Page <%= page %> of <%= totalPages %></span>
      <% if (page < totalPages) { %>
        <a href="?page=<%= page + 1 %>&gameName=<%= selectedGame %>&result=<%= selectedResult %>&userId=<%= selectedUser %>" class="btn btn-secondary btn-sm">Next &rarr;</a>
      <% } %>
    </div>
  </div>

</div>

<%- include('partials/footer') %>
