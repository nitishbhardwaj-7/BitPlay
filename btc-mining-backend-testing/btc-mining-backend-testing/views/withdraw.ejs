<%- include('partials/header', { title }) %>
<%- include('partials/sidebar', { user }) %>

<div class="main-content">
  <div class="card-container">
    <div id="withdrawalError" class="alert alert-danger alert-dismissible fade show d-none" role="alert">
      <strong>Error:</strong> <span id="withdrawalErrorText"></span>
      <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
    <div class="card-header d-flex justify-content-between align-items-center">
      <h2>Withdrawals</h2>
      <form class="d-flex" method="GET" action="/admin/withdrawals">
        <input type="text" name="search" class="form-control me-2" placeholder="Search by name, email, status, txHash" value="<%= typeof search !== 'undefined' ? search : '' %>" style="min-width: 220px;" />
        <button type="submit" class="btn btn-outline-primary">Search</button>
      </form>
    </div>

    <div class="table-responsive data-table">
      <table class="table table-striped table-bordered align-middle">
        <thead class="table-dark">
          <tr>
            <th>#</th>
            <th>Name</th>
            <th>Email</th>
            <th>Asset</th>
            <th>Chain</th>
            <th>To Address</th>
            <th>Amount</th>
            <th>Status</th>
            <th>TxHash</th>
            <th>Created At</th>
            <th>Action</th>
          </tr>
        </thead>
        <tbody id="withdrawalsTbody">
          <% withdrawals.forEach((w, index) => { %>
            <tr data-id="<%= w._id %>">
              <td><%= (page - 1) * limit + index + 1 %></td>
              <td><%= w.userName || '-' %></td>
              <td><%= w.userEmail || '-' %></td>
              <td><%= w.asset %></td>
              <td><%= w.chain %></td>
              <td class="text-nowrap">
                <% const addr = (w.toAddress || '-'); const addrEsc = addr.replace(/"/g, '&quot;').replace(/</g, '&lt;').replace(/>/g, '&gt;'); %>
                <span class="withdrawal-address" title="<%= addrEsc %>" data-address="<%= addrEsc %>" style="max-width: 160px; display: inline-block; overflow: hidden; text-overflow: ellipsis; vertical-align: middle; cursor: pointer;" role="button" tabindex="0"><%= addr %></span>
                <button type="button" class="btn btn-sm btn-outline-secondary copy-address-btn ms-1" title="Copy address" data-address="<%= addrEsc %>" aria-label="Copy address">&nbsp;&#9100;&nbsp;</button>
              </td>
              <td>
                <%= w.displayAmount || '0' %> <%= w.asset %> / <%= w.displayBtc != null ? w.displayBtc + ' BTC' : '— BTC' %>
              </td>
              <td><span class="badge bg-<%= w.status === 'PENDING' ? 'warning' : w.status === 'APPROVED' ? 'info' : w.status === 'SENT' ? 'primary' : w.status === 'CONFIRMED' ? 'success' : 'danger' %>"><%= w.status %></span></td>
              <td><%= w.txHash || '-' %></td>
              <td><%= new Date(w.created_at).toLocaleDateString() %></td>
              <td>
                <% if (w.status === 'PENDING') { %>
                  <button class="btn btn-sm btn-success approve-btn">Approve</button>
                  <button class="btn btn-sm btn-danger reject-btn">Reject</button>
                <% } else { %>
                  <span>-</span>
                <% } %>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>

    <!-- Pagination -->
    <div class="pagination mt-3">
      <% if (page > 1) { %>
        <a href="?page=<%= page - 1 %><%= typeof search !== 'undefined' && search ? '&search=' + encodeURIComponent(search) : '' %>" class="btn btn-outline-primary me-2">Prev</a>
      <% } %>
      <span>Page <%= page %></span>
      <% if (withdrawals.length === limit) { %>
        <a href="?page=<%= page + 1 %><%= typeof search !== 'undefined' && search ? '&search=' + encodeURIComponent(search) : '' %>" class="btn btn-outline-primary ms-2">Next</a>
      <% } %>
    </div>
  </div>
</div>

<script>
  document.querySelectorAll('.withdrawal-address, .copy-address-btn').forEach(el => {
    el.addEventListener('click', function () {
      const cell = this.closest('td');
      const addrEl = cell.querySelector('[data-address]');
      const addr = addrEl ? (addrEl.getAttribute('data-address') || '') : '';
      if (!addr) return;
      navigator.clipboard.writeText(addr).then(() => {
        const btn = cell.querySelector('.copy-address-btn');
        if (btn) {
          const orig = btn.innerHTML;
          btn.innerHTML = ' Copied! ';
          btn.classList.add('text-success');
          setTimeout(() => { btn.innerHTML = orig; btn.classList.remove('text-success'); }, 1200);
        }
      }).catch(() => {});
    });
  });
  function showWithdrawalError(message, details) {
    const el = document.getElementById('withdrawalError');
    const textEl = document.getElementById('withdrawalErrorText');
    if (!el || !textEl) return;
    textEl.textContent = message + (details ? ' ' + details : '');
    el.classList.remove('d-none');
    el.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
  }
  function hideWithdrawalError() {
    const el = document.getElementById('withdrawalError');
    if (el) el.classList.add('d-none');
  }

  document.querySelectorAll('.approve-btn').forEach(btn => {
    btn.addEventListener('click', async () => {
      hideWithdrawalError();
      const row = btn.closest('tr');
      const id = row.dataset.id;
      if (!confirm('Approve this withdrawal?')) return;
      const res = await fetch(`/api/withdrawals/${id}/approve`, { method: 'PATCH' });
      if (res.ok) location.reload();
      else {
        let msg = 'Failed to approve';
        let details = '';
        try {
          const data = await res.json();
          if (data.error) msg = data.error;
          if (data.details) details = data.details;
        } catch (_) {}
        showWithdrawalError(msg, details);
      }
    });
  });

  document.querySelectorAll('.reject-btn').forEach(btn => {
    btn.addEventListener('click', async () => {
      hideWithdrawalError();
      const row = btn.closest('tr');
      const id = row.dataset.id;
      if (!confirm('Reject this withdrawal?')) return;
      const res = await fetch(`/api/withdrawals/${id}/reject`, { method: 'PATCH' });
      if (res.ok) location.reload();
      else {
        let msg = 'Failed to reject';
        try {
          const data = await res.json();
          if (data.error) msg = data.error;
          showWithdrawalError(msg, data.details || '');
        } catch (_) {
          showWithdrawalError(msg, '');
        }
      }
    });
  });
</script>

<%- include('partials/footer') %>
