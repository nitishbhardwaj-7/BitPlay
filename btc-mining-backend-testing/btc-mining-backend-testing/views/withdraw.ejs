<%- include('partials/header', { title }) %>
<%- include('partials/sidebar', { title, user }) %>

<div class="page-inner">

  <div id="withdrawalError" class="alert alert-danger alert-dismissible fade show d-none mb-4" role="alert">
    <strong>Error:</strong> <span id="withdrawalErrorText"></span>
    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
  </div>

  <!-- Page Hero -->
  <div class="page-hero">
    <div class="page-hero-text">
      <h1>Withdrawals</h1>
      <p>Review and manage user withdrawal requests</p>
    </div>
    <div class="page-hero-actions">
      <form class="d-flex gap-2" method="GET" action="/admin/withdrawals">
        <div class="search-bar">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
          <input type="text" name="search" placeholder="Search by name, email, status, txHash" value="<%= typeof search !== 'undefined' ? search : '' %>" />
        </div>
        <button type="submit" class="btn btn-secondary">Search</button>
      </form>
    </div>
  </div>

  <!-- Table Card -->
  <div class="data-card">
    <div class="table-wrapper">
      <table class="table table-hover align-middle">
        <thead>
          <tr>
            <th>#</th>
            <th>Name</th>
            <th>Email</th>
            <th>Asset</th>
            <th>Chain</th>
            <th>To Address</th>
            <th>Amount</th>
            <th>Status</th>
            <th>TxHash</th>
            <th>Date</th>
            <th>Action</th>
          </tr>
        </thead>
        <tbody id="withdrawalsTbody">
          <% withdrawals.forEach((w, index) => { %>
            <tr data-id="<%= w._id %>">
              <td style="color:var(--text-faint);font-size:12px"><%= (page - 1) * limit + index + 1 %></td>
              <td style="font-weight:600;color:var(--text)"><%= w.userName || '-' %></td>
              <td style="color:var(--text-faint)"><%= w.userEmail || '-' %></td>
              <td><span class="badge bg-secondary"><%= w.asset %></span></td>
              <td style="color:var(--text-faint);font-size:12px"><%= w.chain %></td>
              <td class="text-nowrap">
                <% const addr = (w.toAddress || '-'); const addrEsc = addr.replace(/"/g, '&quot;').replace(/</g, '&lt;').replace(/>/g, '&gt;'); %>
                <span class="withdrawal-address" title="<%= addrEsc %>" data-address="<%= addrEsc %>" style="font-family:monospace;font-size:12px;max-width:140px;display:inline-block;overflow:hidden;text-overflow:ellipsis;vertical-align:middle;cursor:pointer" role="button" tabindex="0"><%= addr %></span>
                <button type="button" class="btn btn-ghost btn-sm copy-address-btn ms-1" title="Copy address" data-address="<%= addrEsc %>" aria-label="Copy address">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="width:12px;height:12px"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
                </button>
              </td>
              <td style="font-weight:600">
                <%= w.displayAmount || '0' %> <%= w.asset %> / <%= w.displayBtc != null ? w.displayBtc + ' BTC' : '— BTC' %>
              </td>
              <td><span class="badge bg-<%= w.status === 'PENDING' ? 'warning' : w.status === 'APPROVED' ? 'info' : w.status === 'SENT' ? 'primary' : w.status === 'CONFIRMED' ? 'success' : 'danger' %>"><%= w.status %></span></td>
              <td style="font-family:monospace;font-size:11px;max-width:100px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap"><%= w.txHash || '-' %></td>
              <td style="white-space:nowrap;color:var(--text-faint);font-size:12px"><%= new Date(w.created_at).toLocaleDateString('en-US',{month:'short',day:'numeric',year:'numeric'}) %></td>
              <td>
                <% if (w.status === 'PENDING') { %>
                  <div class="d-flex gap-1">
                    <button class="btn btn-success btn-sm approve-btn">Approve</button>
                    <button class="btn btn-danger btn-sm reject-btn">Reject</button>
                  </div>
                <% } else { %>
                  <span style="color:var(--text-faint);font-size:12px">—</span>
                <% } %>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>

    <% if (withdrawals.length === 0) { %>
      <div class="empty-state">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
        <h4>No withdrawals found</h4>
        <p>No withdrawal requests match your current search</p>
      </div>
    <% } %>

    <div class="pag-bar">
      <% if (page > 1) { %>
        <a href="?page=<%= page - 1 %><%= typeof search !== 'undefined' && search ? '&search=' + encodeURIComponent(search) : '' %>" class="btn btn-secondary btn-sm">&larr; Prev</a>
      <% } %>
      <span class="pag-info">Page <%= page %></span>
      <% if (withdrawals.length === limit) { %>
        <a href="?page=<%= page + 1 %><%= typeof search !== 'undefined' && search ? '&search=' + encodeURIComponent(search) : '' %>" class="btn btn-secondary btn-sm">Next &rarr;</a>
      <% } %>
    </div>
  </div>

</div>

<script>
  document.querySelectorAll('.withdrawal-address, .copy-address-btn').forEach(el => {
    el.addEventListener('click', function () {
      const cell = this.closest('td');
      const addrEl = cell.querySelector('[data-address]');
      const addr = addrEl ? (addrEl.getAttribute('data-address') || '') : '';
      if (!addr) return;
      navigator.clipboard.writeText(addr).then(() => {
        const btn = cell.querySelector('.copy-address-btn');
        if (btn) {
          const orig = btn.innerHTML;
          btn.innerHTML = ' Copied! ';
          btn.classList.add('text-success');
          setTimeout(() => { btn.innerHTML = orig; btn.classList.remove('text-success'); }, 1200);
        }
      }).catch(() => {});
    });
  });
  function showWithdrawalError(message, details) {
    const el = document.getElementById('withdrawalError');
    const textEl = document.getElementById('withdrawalErrorText');
    if (!el || !textEl) return;
    textEl.textContent = message + (details ? ' ' + details : '');
    el.classList.remove('d-none');
    el.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
  }
  function hideWithdrawalError() {
    const el = document.getElementById('withdrawalError');
    if (el) el.classList.add('d-none');
  }

  document.querySelectorAll('.approve-btn').forEach(btn => {
    btn.addEventListener('click', async () => {
      hideWithdrawalError();
      const row = btn.closest('tr');
      const id = row.dataset.id;
      if (!confirm('Approve this withdrawal?')) return;
      const res = await fetch(`/api/withdrawals/${id}/approve`, { method: 'PATCH' });
      if (res.ok) location.reload();
      else {
        let msg = 'Failed to approve';
        let details = '';
        try {
          const data = await res.json();
          if (data.error) msg = data.error;
          if (data.details) details = data.details;
        } catch (_) {}
        showWithdrawalError(msg, details);
      }
    });
  });

  document.querySelectorAll('.reject-btn').forEach(btn => {
    btn.addEventListener('click', async () => {
      hideWithdrawalError();
      const row = btn.closest('tr');
      const id = row.dataset.id;
      if (!confirm('Reject this withdrawal?')) return;
      const res = await fetch(`/api/withdrawals/${id}/reject`, { method: 'PATCH' });
      if (res.ok) location.reload();
      else {
        let msg = 'Failed to reject';
        try {
          const data = await res.json();
          if (data.error) msg = data.error;
          showWithdrawalError(msg, data.details || '');
        } catch (_) {
          showWithdrawalError(msg, '');
        }
      }
    });
  });
</script>

<%- include('partials/footer') %>
