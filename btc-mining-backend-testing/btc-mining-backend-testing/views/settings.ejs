<%- include('partials/header', { title: 'Settings' }) %>
<%- include('partials/sidebar', { title: 'Settings', user }) %>

<div class="page-inner">

  <div class="page-hero">
    <div class="page-hero-text">
      <h1>System Settings</h1>
      <p>BitPlayPro admin panel configuration overview</p>
    </div>
  </div>

  <div class="info-grid">
    <div class="info-card">
      <div class="label">Site Name</div>
      <div class="value">Bitcoin Mining Admin Panel</div>
    </div>
    <div class="info-card">
      <div class="label">Database Connection</div>
      <div class="value success">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" style="width:14px;height:14px;margin-right:6px;vertical-align:middle"><polyline points="20 6 9 17 4 12"/></svg>
        MongoDB Atlas — Connected
      </div>
    </div>
    <div class="info-card">
      <div class="label">Session Timeout</div>
      <div class="value">24 hours</div>
    </div>
    <div class="info-card">
      <div class="label">Default Password</div>
      <div class="value" style="font-family:monospace;letter-spacing:0.5px">admin@123</div>
    </div>
    <div class="info-card">
      <div class="label">Server Status</div>
      <div class="value success">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" style="width:14px;height:14px;margin-right:6px;vertical-align:middle"><polyline points="20 6 9 17 4 12"/></svg>
        Running on Port 3001
      </div>
    </div>
    <div class="info-card">
      <div class="label">Environment</div>
      <div class="value warning">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width:14px;height:14px;margin-right:6px;vertical-align:middle"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></svg>
        Development Mode
      </div>
    </div>
  </div>

</div>

<%- include('partials/footer') %>
